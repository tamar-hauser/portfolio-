const int calfRaiseReferenceCount = sizeof(calfRaiseReference) / sizeof(ReferenceFrame);

const int MAX_APP_REFERENCE_FRAMES = 400;
ReferenceFrame appReferenceBuffer[MAX_APP_REFERENCE_FRAMES];

bool parseCsvReferenceLine(char* line, ReferenceFrame &out) {
  float values[18];
  char* token = strtok(line, ",");
  for (int i = 0; i < 18; i++) {
    if (!token) return false;
    values[i] = atof(token);
    token = strtok(nullptr, ",");
  }
  out.r_fsr0 = (int)values[0]; out.r_fsr1 = (int)values[1]; out.r_fsr2 = (int)values[2];
  out.r_ax = values[3]; out.r_ay = values[4]; out.r_az = values[5];
  out.r_gx = values[6]; out.r_gy = values[7]; out.r_gz = values[8];
  out.l_fsr0 = (int)values[9]; out.l_fsr1 = (int)values[10]; out.l_fsr2 = (int)values[11];
  out.l_ax = values[12]; out.l_ay = values[13]; out.l_az = values[14];
  out.l_gx = values[15]; out.l_gy = values[16]; out.l_gz = values[17];
  return true;
}

bool fetchReferenceFromApp(const char* exerciseId, int* outCount) {
  if (WiFi.status() != WL_CONNECTED) return false;

  HTTPClient http;
  http.begin(firestoreBaseUrl + "/referenceFrames/" + exerciseId);
  int code = http.GET();
  if (code != 200) {
    http.end();
    return false;
  }

  JsonDocument doc;
  deserializeJson(doc, http.getString());
  http.end();

  const char* format = doc["fields"]["format"]["stringValue"];
  const char* content = doc["fields"]["content"]["stringValue"];
  if (!format || !content || strcmp(format, "csv") != 0) return false;

  String csv(content);
  int frameCount = 0;
  int start = 0;
  while (start < (int)csv.length() && frameCount < MAX_APP_REFERENCE_FRAMES) {
    int newlineIndex = csv.indexOf('\n', start);
    String line = (newlineIndex == -1) ? csv.substring(start) : csv.substring(start, newlineIndex);
    line.trim();
    if (line.length() > 0) {
      char lineBuf[300];
      strncpy(lineBuf, line.c_str(), sizeof(lineBuf) - 1);
      lineBuf[sizeof(lineBuf) - 1] = '\0';
      if (parseCsvReferenceLine(lineBuf, appReferenceBuffer[frameCount])) frameCount++;
    }
    if (newlineIndex == -1) break;
    start = newlineIndex + 1;
  }

  *outCount = frameCount;
  return frameCount > 0;
}
