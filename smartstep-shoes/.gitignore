# ---- Local-only working material (raw video, exam files, backups) ----
_local/

# ---- Python: local STT server ----
server/.venv/
# Whisper "medium" weights (~1.5 GB) - downloaded separately, see server/README.md
server/whisper_medium_model/
# TTS clips regenerated by generate_voice_feedback.py / generate_combo_feedback.py
server/speaker_audio/
__pycache__/
*.pyc

# ---- Node / React app ----
node_modules/
app/dist/
app/dist-ssr/
*.local

# ---- Secrets: real keys live here, only .env.example is tracked ----
# Firmware credentials are masked as "********" in the sketches themselves.
.env
.env.local

# ---- Editors / OS ----
.claude/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

